# ─────────────────────────────────────────────────────────────
# Dev-in.tw Backend 環境變數範本
# 複製此檔為 .env 後填入實際數值：cp .env.example .env
# .env 已被 .gitignore 忽略，請勿提交含密鑰的檔案
# ─────────────────────────────────────────────────────────────

# 伺服器監聽埠號（未設定時程式預設 3001）
PORT=3001

# MongoDB 連線字串
# 程式以 authSource=admin 連線（見 src/main.ts）
# 本機範例：mongodb://localhost:27017/dev-in-tw
# 含帳密範例：mongodb://<user>:<password>@localhost:27017/dev-in-tw
MONGO_URI=mongodb://localhost:27017/dev-in-tw

# GitHub OAuth App 憑證
# 取得位置：https://github.com/settings/developers → OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
