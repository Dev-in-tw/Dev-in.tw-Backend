# ─────────────────────────────────────────────────────────────
# Dev-in.tw Backend 環境變數範本
# 複製此檔為 .env 後填入實際數值：cp .env.example .env
# .env 已被 .gitignore 忽略，請勿提交含密鑰的檔案
# ─────────────────────────────────────────────────────────────

# 伺服器監聽埠號（未設定時程式預設 3001）
PORT=3001

# MongoDB 連線字串
# 程式以 authSource=admin 連線（見 src/main.ts）
# 本機範例：mongodb://localhost:27017/dev-in-tw
# 含帳密範例：mongodb://<user>:<password>@localhost:27017/dev-in-tw
MONGO_URI=mongodb://localhost:27017/dev-in-tw

# GitHub OAuth App 憑證
# 取得位置：https://github.com/settings/developers → OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# JWT 簽章密鑰（登入後簽發 token 用）
# 請使用 >=32 字元的隨機字串，例如：openssl rand -base64 48
JWT_SECRET=

# JWT 有效期限（未設定時程式預設 7d）
# 格式見 vercel/ms，例如：7d、12h、3600
JWT_EXPIRES_IN=7d

# 允許的前端來源（CORS），多個來源以逗號分隔
# 本機範例：http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Cloudflare API Token（scoped 到 dev-in.tw zone，權限 Zone-DNS-Edit）
# 取得位置：Cloudflare Dashboard → My Profile → API Tokens → Create Token
# 範本選「Edit zone DNS」、Zone Resources 限定 dev-in.tw
CLOUDFLARE_API_TOKEN=

# Cloudflare Zone ID（dev-in.tw 的 zone 識別碼）
# 取得位置：Cloudflare Dashboard → dev-in.tw → Overview 右側欄 API 區塊
CLOUDFLARE_ZONE_ID=

# 子網域的根網域（用來組 <name>.<ROOT_DOMAIN> 與 DNS scoping）
# 本機/正式範例：dev-in.tw
ROOT_DOMAIN=dev-in.tw
